{
  "expo": {
    "name": "hilt-mobile",
    "slug": "hilt-mobile",
    "scheme": "hilt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hilt.travel",
      "associatedDomains": [
        "applinks:hilt.travel",
        "webcredentials:hilt.travel"
      ]
    },
    "android": {
      "package": "com.hilt.travel",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hilt.travel",
              "pathPrefix": "/stay"
            },
            {
              "scheme": "https",
              "host": "hilt.travel",
              "pathPrefix": "/trip"
            },
            {
              "scheme": "https",
              "host": "hilt.travel",
              "pathPrefix": "/plan"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0F1419"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Hilt to access your photos to add stay pictures.",
          "cameraPermission": "Allow Hilt to use your camera to add stay pictures.",
          "microphonePermission": false
        }
      ],
      "expo-localization"
    ]
  }
}
