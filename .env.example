EXPO_PUBLIC_SUPABASE_URL=YOUR_VALUE_HERE
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_VALUE_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_VALUE_HERE


# Razorpay Credentials (LMS Project)
EXPO_PUBLIC_RAZORPAY_KEY_ID=YOUR_VALUE_HERE
RAZORPAY_KEY_SECRET=YOUR_VALUE_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_VALUE_HERE

# Google OAuth
EXPO_PUBLIC_GOOGLE_CLIENT_ID=YOUR_VALUE_HERE
GOOGLE_CLIENT_SECRET=YOUR_VALUE_HERE

# Ghumna Phirna planner — Gemini 2.5 Flash Lite via OpenRouter
EXPO_PUBLIC_OPENROUTER_API_KEY=YOUR_VALUE_HERE
OPENROUTER_API_KEY=YOUR_VALUE_HERE

# Optional fallback: Google Gemini direct (get a key at https://aistudio.google.com)
EXPO_PUBLIC_GEMINI_API_KEY=YOUR_VALUE_HERE

# Sandbox.co.in Aadhaar KYC
EXPO_PUBLIC_SANDBOX_API_KEY=YOUR_VALUE_HERE
SANDBOX_SECRET=YOUR_VALUE_HERE

# Wayzyy chat moderation (optional Tier-3 LLM judge; engine runs on-device without it)
EXPO_PUBLIC_WAYZYY_GROQ_KEY=YOUR_VALUE_HERE

